@* EN: Visualizes the governed request as four ordered stages and explains policy decisions and outputs.
    JA: ガバナンス対象リクエストを 4 つの順序付き段階として可視化し、ポリシー判断と出力を説明します。 *@

@using AgentGovernanceDemo.Governance
@using AgentGovernanceDemo.Presentation
@inject GovernanceDemoService Governance
@inject UiLocalizer L

<section class="execution-flow @FlowClass"
         aria-label="@L["ExecutionFlow"]">
    <div class="flow-heading">
        <div>
            <p class="flow-eyebrow">EXECUTION FLOW</p>
            <h3>@L["RequestToResult"]</h3>
        </div>
        <span class="run-status status-@RunStatusClass">
            <span aria-hidden="true">@RunStatusIcon</span>
            @RunStatusLabel
        </span>
    </div>

    @if (IsReady)
    {
        <div class="ready-state" role="status">
            <span class="ready-icon" aria-hidden="true">◇</span>
            <div>
                <strong>@L["ReadyToRun"]</strong>
                <span>@L["ReadyDescription"]</span>
            </div>
        </div>
    }

    <ol class="stage-flow" aria-label="@L["FourStages"]">
        @for (var index = 0; index < State.Stages.Count; index++)
        {
            var stage = State.Stages[index];
            var status = DisplayStatus(stage);

            <li class="stage-item">
                <article class="stage-card stage-@StatusClass(status)"
                         aria-label="@($"{StageTitle(stage.Kind)}: {StatusLabel(status)}")"
                         aria-current="@(status == ExecutionFlowStageStatus.Active ? "step" : null)">
                    <div class="stage-card-header">
                        <span class="stage-icon kind-@KindClass(stage.Kind)" aria-hidden="true">
                            @StageIcon(stage.Kind)
                        </span>
                        <span class="stage-number">@L.Format("Stage", index + 1)</span>
                    </div>
                    <h4>@StageTitle(stage.Kind)</h4>
                    <span class="stage-status">
                        <span class="status-symbol" aria-hidden="true">@StatusIcon(status)</span>
                        @StatusLabel(status)
                    </span>
                    <p class="stage-message">@StageMessage(stage, status)</p>
                    @if (IsDeniedStage(stage, status))
                    {
                        <strong class="denial-callout">
                            <span aria-hidden="true">!</span>
                            @L["GovernanceRejected"]
                        </strong>
                    }
                </article>

                @if (index < State.Stages.Count - 1)
                {
                    <div class="connector connector-@ConnectorClass(status)"
                         aria-hidden="true">
                        <span></span>
                        <b>›</b>
                    </div>
                }
            </li>
        }
    </ol>

    <div class="flow-details">
        <section class="detail-card decision-card" aria-labelledby="decision-heading">
            <div class="detail-heading">
                <span aria-hidden="true">◆</span>
                <h4 id="decision-heading">@L["DecisionReason"]</h4>
            </div>
            <p>@DecisionText</p>
        </section>

        <section class="detail-card output-card" aria-labelledby="output-heading">
            <div class="detail-heading">
                <span aria-hidden="true">▣</span>
                <h4 id="output-heading">@L["OutputDetail"]</h4>
            </div>
            <pre>@OutputText</pre>
        </section>
    </div>

    <GovernanceCodePathView State="CodePathState" />

    @if (!IsReady)
    {
        <p class="visually-hidden" aria-live="polite" aria-atomic="true">
            @LiveSummary
        </p>
    }
</section>

@code {
    // EN: The component receives a fully reconciled presentation model and contains no governance decisions itself.
    // JA: このコンポーネントは統合済み表示モデルを受け取り、自身ではガバナンス判断を行いません。
    [Parameter, EditorRequired]
    public ExecutionFlowState State { get; set; } = ExecutionFlowState.Initial;

    [Parameter, EditorRequired]
    public GovernanceScenario Scenario { get; set; } = default!;

    [Parameter]
    public DemoRunStatus? RunStatus { get; set; }

    [Parameter]
    public string? RunDetail { get; set; }

    private GovernanceCodePathState CodePathState =>
        GovernanceCodePathState.Create(
            Scenario,
            State,
            RunStatus,
            Governance.PolicyDefinition);

    private bool IsReady =>
        RunStatus is null
        && State.Stages.All(stage => string.IsNullOrWhiteSpace(stage.Message))
        && string.IsNullOrWhiteSpace(State.DecisionReason)
        && string.IsNullOrWhiteSpace(State.Output)
        && string.IsNullOrWhiteSpace(RunDetail);

    private bool IsDenied =>
        RunStatus == DemoRunStatus.Denied
        || State.GovernanceGate.Status == ExecutionFlowStageStatus.Denied;

    private string FlowClass => IsDenied ? "flow-denied" : string.Empty;

    private string RunStatusLabel => RunStatus switch
    {
        DemoRunStatus.Running => L["Running"],
        DemoRunStatus.Allowed => L["Allowed"],
        DemoRunStatus.Denied => L["Denied"],
        DemoRunStatus.Failed => L["Failed"],
        _ => L["Ready"]
    };

    private string RunStatusClass => RunStatus?.ToString().ToLowerInvariant() ?? "ready";

    private string RunStatusIcon => RunStatus switch
    {
        DemoRunStatus.Running => "●",
        DemoRunStatus.Allowed => "✓",
        DemoRunStatus.Denied => "!",
        DemoRunStatus.Failed => "×",
        _ => "◇"
    };

    private string DecisionText => !string.IsNullOrWhiteSpace(State.DecisionReason)
        ? LocalizedDecision
        : IsReady
            ? L["DecisionPlaceholder"]
            : L["NoDecision"];

    private string OutputText => !string.IsNullOrWhiteSpace(State.Output)
        ? LocalizedOutput
        : IsDenied
            ? L["NoToolOutput"]
            : !string.IsNullOrWhiteSpace(RunDetail)
                ? RunDetail
                : IsReady
                    ? L["OutputPlaceholder"]
                    : L["NoOutputAvailable"];

    private string LocalizedOutput => Scenario.ToolName switch
    {
        "GetWeather" => L["WeatherOutput"],
        "GetTime" => L["TimeOutput"],
        "GetLocation" => L["LocationOutput"],
        _ => State.Output ?? L["NoOutputAvailable"]
    };

    private string LocalizedDecision => State.Decision?.GateKind switch
    {
        GovernanceGateKind.AllowlistRule => L["DecisionAllowlist"],
        GovernanceGateKind.ExplicitDenyRule => L["DecisionExplicitDeny"],
        GovernanceGateKind.DefaultDeny => L["DecisionDefaultDeny"],
        GovernanceGateKind.PromptInjectionDetection => L["DecisionPromptInjection"],
        _ => State.DecisionReason ?? L["NoDecision"]
    };

    private string LiveSummary =>
        $"{RunStatusLabel}. "
        + string.Join(
            ", ",
            State.Stages.Select(stage => $"{StageTitle(stage.Kind)} {StatusLabel(DisplayStatus(stage))}"));

    private ExecutionFlowStageStatus DisplayStatus(ExecutionFlowStage stage) =>
        IsReady ? ExecutionFlowStageStatus.Pending : stage.Status;

    private static bool IsDeniedStage(
        ExecutionFlowStage stage,
        ExecutionFlowStageStatus status) =>
        stage.Kind == ExecutionFlowStageKind.GovernanceGate
        && status == ExecutionFlowStageStatus.Denied;

    private string StageMessage(
        ExecutionFlowStage stage,
        ExecutionFlowStageStatus status)
    {
        if (stage.Kind == ExecutionFlowStageKind.Result
            && status == ExecutionFlowStageStatus.Succeeded
            && !string.IsNullOrWhiteSpace(stage.Message))
        {
            return stage.Message;
        }

        return status switch
        {
            ExecutionFlowStageStatus.Pending => L["WaitingStage"],
            ExecutionFlowStageStatus.Active => L["ActiveStage"],
            ExecutionFlowStageStatus.Succeeded => L["CompletedStage"],
            ExecutionFlowStageStatus.Denied => L["BlockedStage"],
            ExecutionFlowStageStatus.Skipped => L["SkippedStage"],
            ExecutionFlowStageStatus.Failed => L["FailedStage"],
            _ => string.Empty
        };
    }

    private string StageTitle(ExecutionFlowStageKind kind) => kind switch
    {
        ExecutionFlowStageKind.Request => L["Request"],
        ExecutionFlowStageKind.GovernanceGate => L["GovernanceGate"],
        ExecutionFlowStageKind.ToolExecution => L["ToolExecution"],
        ExecutionFlowStageKind.Result => L["Result"],
        _ => L["Unknown"]
    };

    private static string KindClass(ExecutionFlowStageKind kind) =>
        kind switch
        {
            ExecutionFlowStageKind.Request => "request",
            ExecutionFlowStageKind.GovernanceGate => "governance",
            ExecutionFlowStageKind.ToolExecution => "tool",
            ExecutionFlowStageKind.Result => "result",
            _ => "unknown"
        };

    private static string StageIcon(ExecutionFlowStageKind kind) =>
        kind switch
        {
            ExecutionFlowStageKind.Request => "→",
            ExecutionFlowStageKind.GovernanceGate => "◆",
            ExecutionFlowStageKind.ToolExecution => "⚙",
            ExecutionFlowStageKind.Result => "✓",
            _ => "•"
        };

    private static string StatusClass(ExecutionFlowStageStatus status) =>
        status.ToString().ToLowerInvariant();

    private static string ConnectorClass(ExecutionFlowStageStatus status) =>
        status switch
        {
            ExecutionFlowStageStatus.Succeeded => "complete",
            ExecutionFlowStageStatus.Active => "active",
            ExecutionFlowStageStatus.Denied or ExecutionFlowStageStatus.Failed => "stopped",
            ExecutionFlowStageStatus.Skipped => "skipped",
            _ => "pending"
        };

    private string StatusLabel(ExecutionFlowStageStatus status) =>
        status switch
        {
            ExecutionFlowStageStatus.Pending => L["Pending"],
            ExecutionFlowStageStatus.Active => L["Active"],
            ExecutionFlowStageStatus.Succeeded => L["Succeeded"],
            ExecutionFlowStageStatus.Denied => L["Denied"],
            ExecutionFlowStageStatus.Skipped => L["Skipped"],
            ExecutionFlowStageStatus.Failed => L["Failed"],
            _ => L["Unknown"]
        };

    private static string StatusIcon(ExecutionFlowStageStatus status) =>
        status switch
        {
            ExecutionFlowStageStatus.Pending => "○",
            ExecutionFlowStageStatus.Active => "●",
            ExecutionFlowStageStatus.Succeeded => "✓",
            ExecutionFlowStageStatus.Denied => "!",
            ExecutionFlowStageStatus.Skipped => "—",
            ExecutionFlowStageStatus.Failed => "×",
            _ => "?"
        };
}
