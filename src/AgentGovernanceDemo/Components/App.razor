@* EN: Defines the HTML document shell and starts the interactive server-rendered Blazor component tree.
    JA: HTML ドキュメントの外枠を定義し、対話型サーバーレンダリングの Blazor コンポーネントツリーを起動します。 *@

<!DOCTYPE html>
<html lang="ja">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="AgentGovernanceDemo.styles.css" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
</body>

</html>
