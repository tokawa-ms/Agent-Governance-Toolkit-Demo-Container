@page "/"
@inject UiLocalizer L

<PageTitle>@L["HomeTitle"]</PageTitle>

<section class="landing" aria-labelledby="landing-heading">
    <div class="landing-copy">
        <p class="landing-eyebrow">MICROSOFT AGENT GOVERNANCE TOOLKIT</p>
        <h2 id="landing-heading">@L["HomeHeading"]</h2>
        <p>@L["HomeDescription"]</p>
        <div class="landing-actions">
            <NavLink class="primary-link" href="/demo">
                @L["StartDemo"]
                <span aria-hidden="true">→</span>
            </NavLink>
            <a class="secondary-link"
               href="https://github.com/microsoft/agent-governance-toolkit"
               target="_blank"
               rel="noopener noreferrer">
                Agent Governance Toolkit
                <span class="visually-hidden">@L["NewTab"]</span>
            </a>
        </div>
    </div>

    <aside class="landing-preview" aria-label="@L["FlowPreview"]">
        <p>GOVERNED TOOL CALL</p>
        <ol>
            <li><span>1</span><strong>@L["Request"]</strong></li>
            <li><span>2</span><strong>@L["GovernanceGate"]</strong></li>
            <li><span>3</span><strong>@L["ToolExecution"]</strong></li>
            <li><span>4</span><strong>@L["Result"]</strong></li>
        </ol>
        <div class="preview-result">
            <span aria-hidden="true">◆</span>
            @L["FailClosed"]
        </div>
    </aside>
</section>
