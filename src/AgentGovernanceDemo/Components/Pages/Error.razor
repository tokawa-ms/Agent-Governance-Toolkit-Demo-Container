@* EN: Displays a safe production error page and exposes a correlation ID without rendering exception details.
    JA: 例外詳細を表示せず、相関 ID のみを公開する安全な本番エラーページを表示します。 *@

@page "/Error"
@using System.Diagnostics
@inject UiLocalizer L

<PageTitle>@L["ErrorTitle"]</PageTitle>

<h1 class="text-danger">@L["ErrorTitle"]</h1>
<h2 class="text-danger">@L["ErrorMessage"]</h2>

@if (ShowRequestId)
{
    <p>
        <strong>@L["RequestId"]:</strong> <code>@RequestId</code>
    </p>
}

<h3>@L["DevelopmentMode"]</h3>
<p>@L["DevelopmentDescription"]</p>
<p><strong>@L["DevelopmentWarning"]</strong></p>

@code{
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
